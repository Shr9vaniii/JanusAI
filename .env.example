# Copy to .env and fill in real values. Never commit .env.

# Required for query rewrite + multi-query decomposition
GROQ_API_KEY=

# Remote LoRA inference (Colab/ngrok or RunPod)
# Set 2–3 days before interviews; leave empty for retrieval-only smoke tests
INFERENCE_URL=
# Optional shared secret for the generation server
INFERENCE_API_KEY=
RAG_BACKEND=remote

# Redis Cloud answer cache (optional; pipeline works without it)
REDIS_URL=
CACHE_TTL_SECONDS=604800
CACHE_VERSION=v2
MODEL_VERSION=lora_v2

# CORS for a separately hosted static UI (default * is fine when API serves web/dist)
CORS_ORIGINS=*

# Optional overrides
REWRITE_MODEL=llama-3.1-8b-instant
DECOMPOSE_MODEL=llama-3.1-8b-instant
LORA_PATH=
BASE_MODEL=unsloth/Llama-3.1-8B-Instruct
LOG_LEVEL=INFO
